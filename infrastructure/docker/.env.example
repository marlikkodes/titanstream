# TitanStream Production Environment
# Copy this to .env and fill in real values

# ── Database ──────────────────────────────────────────────────
POSTGRES_USER=titanstream
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password
POSTGRES_DB=titanstream

# ── API ───────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_min_32_chars_random_string
NODE_ENV=production

# ── Telegram ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBAPP_URL=https://yourdomain.com

# ── Pesapal (optional) ────────────────────────────────────────
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_CALLBACK_URL=https://api.yourdomain.com/api/v1/payments/callback

# ── Frontend build ─────────────────────────────────────────────
VITE_API_BASE_URL=https://api.yourdomain.com
VITE_APP_URL=https://yourdomain.com
