# TitanStream Local Docker Environment Configuration
# Copy this file to .env before starting Docker Compose

# ── Database ──────────────────────────────────────────────────
POSTGRES_USER=titanstream
POSTGRES_PASSWORD=titanstream_secret_pass_2026
POSTGRES_DB=titanstream
POSTGRES_PORT=5432

# ── API Runtime ───────────────────────────────────────────────
NODE_ENV=production
PORT=3000
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_12345
JWT_REFRESH_SECRET=super_secret_refresh_key_at_least_32_characters_long_12345

# ── Telegram Mini App & Bot ───────────────────────────────────
TELEGRAM_BOT_TOKEN=dummy_telegram_bot_token
TELEGRAM_WEBAPP_URL=http://localhost:8080

# ── Payment Rails (Optional / Sandbox) ────────────────────────
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_CALLBACK_URL=http://localhost:3000/api/v1/payments/callback

# ── Frontend Build Injections ─────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000
VITE_APP_URL=http://localhost:8080
