// ============================================================
// GAME ECONOMY — closed-loop crystal economy + game sessions
// ============================================================

enum CrystalTransactionType {
  DAILY_LOGIN
  GAME_ENTRY
  GAME_REWARD
  MACHINE_BONUS
  ACHIEVEMENT
  EVENT_BONUS
  MYSTERY_CHEST
  BOOST
  COSMETIC
  TOURNAMENT
  RETRY
  PURCHASE
  ADMIN_ADJUSTMENT
  REVERSAL
}

enum GameSessionStatus {
  STARTED
  COMPLETED
  REJECTED
  VOID
  EXPIRED
}

enum GameDifficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

enum GameChallengeObjective {
  SCORE_AT_LEAST
  FEWER_MOVES
  WINS
  PLAYS
  PERFECT_ACCURACY
  PERFECT_SESSION
}

enum GameRewardGrantType {
  XP
  EVENT_POINTS
  MYSTERY_BOX
  MACHINE_BOOST
  ACHIEVEMENT_PROGRESS
  BOOST_TOKEN
}

/// First-class crystal balance. Crystals are the gameplay currency and are
/// intentionally kept separate from financial (USDT/TON) balances.
model CrystalAccount {
  id             String   @id @default(uuid()) @map("account_id")
  telegramUserId BigInt   @unique @map("telegram_user_id")
  balance        Int      @default(0) @map("balance")
  lifetimeEarned Int      @default(0) @map("lifetime_earned")
  lifetimeSpent  Int      @default(0) @map("lifetime_spent")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User                 @relation(fields: [telegramUserId], references: [telegramUserId], onDelete: Restrict)
  transactions CrystalTransaction[]

  @@map("crystal_accounts")
}

/// Signed, append-only crystal ledger. `balanceAfter` snapshots the account
/// balance after each movement so the ledger is independently auditable.
model CrystalTransaction {
  id             String                @id @default(uuid()) @map("tx_id")
  telegramUserId BigInt                @map("telegram_user_id")
  accountId      String                @map("account_id")
  type           CrystalTransactionType @map("tx_type")
  amount         Int                   @map("amount")
  balanceAfter   Int                   @map("balance_after")
  reference      String                @unique @map("reference")
  metadata       Json?                 @map("metadata")
  createdAt      DateTime              @default(now()) @map("created_at")

  account CrystalAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  user    User           @relation(fields: [telegramUserId], references: [telegramUserId], onDelete: Restrict)

  @@index([telegramUserId, createdAt])
  @@index([type])
  @@map("crystal_transactions")
}

/// Configurable game catalog. Reward tables are server-side JSON config so
/// administrators can tune costs, limits and payouts without deploys.
model GameCatalog {
  id                   String         @id @default(uuid()) @map("id")
  gameId               String         @unique @map("game_id")
  code                 String         @map("code")
  name                 String         @map("name")
  description          String         @map("description")
  category             String         @map("category")
  icon                 String         @default("🎮") @map("icon")
  accentColor          String         @default("#00e676") @map("accent_color")
  crystalCost          Int            @default(5) @map("crystal_cost")
  dailyLimit           Int            @default(10) @map("daily_limit")
  estimatedDurationSec Int            @default(60) @map("estimated_duration_sec")
  difficulty           GameDifficulty @default(MEDIUM) @map("difficulty")
  enabled              Boolean        @default(true) @map("enabled")
  rewardConfig         Json           @default("{}") @map("reward_config")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  sessions GameSession[]
  events   GameEvent[]
  playerStats     GamePlayerStat[]
  dailyChallenges GameDailyChallenge[]

  @@map("game_catalog")
}

/// Server-authoritative game session. The client never decides payouts;
/// every session is validated and rewarded by the backend.
model GameSession {
  id                String            @id @default(uuid()) @map("session_id")
  telegramUserId    BigInt            @map("telegram_user_id")
  gameId            String            @map("game_id")
  status            GameSessionStatus @default(STARTED) @map("status")
  crystalCost       Int               @map("crystal_cost")
  serverStartedAt   DateTime          @default(now()) @map("server_started_at")
  serverEndedAt     DateTime?         @map("server_ended_at")
  durationMs        Int?              @map("duration_ms")
  score             Int               @default(0) @map("score")
  crystalsEarned    Int               @default(0) @map("crystals_earned")
  usdtEarned        Decimal?          @db.Decimal(36, 18) @map("usdt_earned")
  validation        Json?             @map("validation")
  reference         String            @unique @map("reference")
  createdAt         DateTime          @default(now()) @map("created_at")

  user User         @relation(fields: [telegramUserId], references: [telegramUserId], onDelete: Restrict)
  game GameCatalog  @relation(fields: [gameId], references: [gameId], onDelete: Restrict)

  @@index([telegramUserId, createdAt])
  @@index([gameId, createdAt])
  @@index([telegramUserId, gameId, createdAt])
  @@index([createdAt])
  @@map("game_sessions")
}

/// Per-user game progression. Best scores, streaks and totals feed the
/// leaderboard and progression UI.
model GameProfile {
  telegramUserId     BigInt    @id @map("telegram_user_id")
  highestScore       Int       @default(0) @map("highest_score")
  gamesPlayed        Int       @default(0) @map("games_played")
  gamesWon           Int       @default(0) @map("games_won")
  winStreak          Int       @default(0) @map("win_streak")
  bestWinStreak      Int       @default(0) @map("best_win_streak")
  dailyStreak        Int       @default(0) @map("daily_streak")
  totalCrystalsEarned Int      @default(0) @map("total_crystals_earned")
  totalCrystalsSpent Int       @default(0) @map("total_crystals_spent")
  xpTotal            Int       @default(0) @map("xp_total")
  xpLevel            Int       @default(1) @map("xp_level")
  challengesCompleted Int      @default(0) @map("challenges_completed")
  lastPlayedAt       DateTime? @map("last_played_at")
  lastDailyClaimAt   DateTime? @map("last_daily_claim_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [telegramUserId], references: [telegramUserId], onDelete: Restrict)

  @@map("game_profiles")
}

/// Per-user, per-game progression statistics. Powers personal bests, game
/// achievements and the Game Hub's "Personal Best" display.
model GamePlayerStat {
  id             String   @id @default(uuid()) @map("stat_id")
  telegramUserId BigInt   @map("telegram_user_id")
  gameId         String   @map("game_id")
  gamesPlayed    Int      @default(0) @map("games_played")
  gamesWon       Int      @default(0) @map("games_won")
  highestScore   Int      @default(0) @map("highest_score")
  bestCombo      Int      @default(0) @map("best_combo")
  bestAccuracy   Int      @default(0) @map("best_accuracy")
  bestReactionMs Int      @default(0) @map("best_reaction_ms")
  bestMoves      Int      @default(0) @map("best_moves")
  bestTimeMs     Int      @default(0) @map("best_time_ms")
  bestEfficiency Int      @default(0) @map("best_efficiency")
  levelsCompleted Int     @default(0) @map("levels_completed")
  perfectSessions Int     @default(0) @map("perfect_sessions")
  xpEarned       Int      @default(0) @map("xp_earned")
  lastPlayedAt   DateTime @default(now()) @map("last_played_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User        @relation(fields: [telegramUserId], references: [telegramUserId], onDelete: Restrict)
  game GameCatalog @relation(fields: [gameId], references: [gameId], onDelete: Restrict)

  @@unique([telegramUserId, gameId])
  @@index([gameId, highestScore])
  @@map("game_player_stats")
}

/// Non-currency reward grants issued by the Rewards Engine (XP, event points,
/// mystery boxes, machine boost tokens, achievement progress, boost tokens).
/// Append-only with unique references so grants are idempotent.
model GameRewardGrant {
  id             String               @id @default(uuid()) @map("grant_id")
  telegramUserId BigInt               @map("telegram_user_id")
  gameId         String               @map("game_id")
  sessionId      String?              @map("session_id")
  type           GameRewardGrantType  @map("type")
  amount         Int                  @default(0) @map("amount")
  reference      String               @unique @map("reference")
  metadata       Json?                @map("metadata")
  createdAt      DateTime             @default(now()) @map("created_at")

  user User @relation(fields: [telegramUserId], references: [telegramUserId], onDelete: Restrict)

  @@index([telegramUserId, createdAt])
  @@index([type])
  @@map("game_reward_grants")
}

/// Rotating daily challenge definitions. Admin configures a pool; each day the
/// engine activates the next due challenge so objectives rotate automatically.
model GameDailyChallenge {
  id            String                 @id @default(uuid()) @map("challenge_id")
  code          String                 @unique @map("code")
  gameId        String                 @map("game_id")
  title         String                 @map("title")
  description   String                 @map("description")
  objectiveType GameChallengeObjective @map("objective_type")
  target        Int                    @map("target")
  rewardCrystals Int                   @default(20) @map("reward_crystals")
  rewardXp      Int                    @default(25) @map("reward_xp")
  enabled       Boolean                @default(true) @map("enabled")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  game GameCatalog @relation(fields: [gameId], references: [gameId], onDelete: Restrict)

  completions GameChallengeCompletion[]

  @@index([enabled])
  @@map("game_daily_challenges")
}

/// Which user completed which daily challenge on which day (idempotent).
model GameChallengeCompletion {
  id             String   @id @default(uuid()) @map("completion_id")
  telegramUserId BigInt   @map("telegram_user_id")
  challengeId    String   @map("challenge_id")
  challengeDay   DateTime @map("challenge_day")
  sessionId      String   @map("session_id")
  rewardCrystals Int      @default(0) @map("reward_crystals")
  rewardXp       Int      @default(0) @map("reward_xp")
  createdAt      DateTime @default(now()) @map("created_at")

  user      User              @relation(fields: [telegramUserId], references: [telegramUserId], onDelete: Restrict)
  challenge GameDailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Restrict)

  @@unique([telegramUserId, challengeId, challengeDay])
  @@map("game_challenge_completions")
}

/// Seasonal / weekend events. Active events apply configurable multipliers to
/// crystal and USDT payouts for specific games (or all games when null).
model GameEvent {
  id               String    @id @default(uuid()) @map("event_id")
  code             String    @unique @map("code")
  title            String    @map("title")
  description      String    @map("description")
  gameId           String?   @map("game_id")
  crystalMultiplier Int      @default(1) @map("crystal_multiplier")
  usdtMultiplier   Decimal   @default(1) @db.Decimal(36, 18) @map("usdt_multiplier")
  startsAt         DateTime  @map("starts_at")
  endsAt           DateTime  @map("ends_at")
  enabled          Boolean   @default(true) @map("enabled")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  game GameCatalog? @relation(fields: [gameId], references: [gameId], onDelete: SetNull)

  @@index([enabled, startsAt, endsAt])
  @@map("game_events")
}

// ===================================================
// STAGE 10 — MACHINE, ASSET LICENSE & ECONOMY ENGINE
// ===================================================

enum MachineStatus {
  ACTIVE
  DISABLED
  ARCHIVED
  MAINTENANCE
}

enum MachineOutputStatus {
  ENABLED
  DISABLED
  LOCKED
  ARCHIVED
}

model MachineCatalogItem {
  id                     String        @id @default(uuid()) @map("machine_id")
  tierCode               String        @unique @map("tier_code")
  name                   String        @map("name")
  description            String        @map("description")
  category               String        @default("STANDARD") @map("category")
  priceUsdt              Decimal       @db.Decimal(36, 18) @map("price_usdt")
  purchaseCurrency       String        @default("USDT") @map("purchase_currency")
  capacityGhs            Decimal       @db.Decimal(36, 18) @map("capacity_ghs")
  dailyYieldEstimateUsdt Decimal       @db.Decimal(36, 18) @map("daily_yield_estimate_usdt")
  displayOrder           Int           @default(0) @map("display_order")
  status                 MachineStatus @default(ACTIVE) @map("status")
  visibility             String        @default("PUBLIC") @map("visibility")
  icon                   String?       @map("icon")
  artwork                String?       @map("artwork")
  theme                  String?       @map("theme")
  upgradePath            String?       @map("upgrade_path")
  availableFrom          DateTime?     @map("available_from")
  availableUntil         DateTime?     @map("available_until")
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  outputs        MachineOutputStream[]
  userFleet      UserMachineFleetItem[]
  timelineEvents MachineTimelineEvent[]

  @@index([status])
  @@index([displayOrder])
  @@map("machine_catalog_items")
}

model MachineOutputStream {
  id             String              @id @default(uuid()) @map("output_id")
  machineId      String              @map("machine_id")
  assetCode      String              @map("asset_code")
  baseYieldRate  Decimal             @db.Decimal(36, 18) @map("base_yield_rate")
  yieldUnit      String              @default("PER_SECOND") @map("yield_unit")
  multiplier     Decimal             @default(1.0) @db.Decimal(36, 18) @map("multiplier")
  decayProfile   String              @default("STANDARD") @map("decay_profile")
  minimumLicense String?             @map("minimum_license")
  displayOrder   Int                 @default(0) @map("display_order")
  status         MachineOutputStatus @default(ENABLED) @map("status")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  machine MachineCatalogItem @relation(fields: [machineId], references: [id], onDelete: Restrict)

  @@unique([machineId, assetCode])
  @@index([machineId])
  @@index([assetCode])
  @@index([status])
  @@map("machine_output_streams")
}

model UserMachineFleetItem {
  id               String   @id @default(uuid()) @map("fleet_item_id")
  telegramUserId   BigInt   @map("telegram_user_id")
  machineId        String   @map("machine_id")
  tierCode         String   @map("tier_code")
  name             String   @map("name")
  purchasePrice    Decimal  @db.Decimal(36, 18) @map("purchase_price")
  currency         String   @default("USDT") @map("currency")
  status           String   @default("ACTIVE") @map("status")
  capacityGhs      Decimal  @db.Decimal(36, 18) @map("capacity_ghs")
  lifetimeEarnings Decimal  @default(0) @db.Decimal(36, 18) @map("lifetime_earnings")
  purchasedAt      DateTime @default(now()) @map("purchased_at")
  activatedAt      DateTime @default(now()) @map("activated_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user    User               @relation(fields: [telegramUserId], references: [telegramUserId], onDelete: Restrict)
  machine MachineCatalogItem @relation(fields: [machineId], references: [id], onDelete: Restrict)

  timelineEvents MachineTimelineEvent[]

  @@index([telegramUserId])
  @@index([machineId])
  @@index([status])
  @@map("user_machine_fleet")
}

model MachineTimelineEvent {
  id            String   @id @default(uuid()) @map("timeline_event_id")
  machineId     String?  @map("machine_id")
  fleetItemId   String?  @map("fleet_item_id")
  eventType     String   @map("event_type")
  actorType     String   @default("SYSTEM") @map("actor_type")
  actorId       String?  @map("actor_id")
  description   String   @map("description")
  metadata      Json?    @default("{}") @map("metadata")
  createdAt     DateTime @default(now()) @map("created_at")

  machine   MachineCatalogItem?   @relation(fields: [machineId], references: [id], onDelete: SetNull)
  fleetItem UserMachineFleetItem? @relation(fields: [fleetItemId], references: [id], onDelete: SetNull)

  @@index([machineId])
  @@index([fleetItemId])
  @@index([eventType])
  @@index([createdAt])
  @@map("machine_timeline_events")
}

model EconomyProfileRecord {
  id                 String   @id @default(uuid()) @map("profile_id")
  code               String   @unique @map("code")
  name               String   @map("name")
  version            Int      @default(1) @map("version")
  yieldMultiplier    Decimal  @default(1.0) @db.Decimal(36, 18) @map("yield_multiplier")
  referralMultiplier Decimal  @default(1.0) @db.Decimal(36, 18) @map("referral_multiplier")
  rewardMultiplier   Decimal  @default(1.0) @db.Decimal(36, 18) @map("reward_multiplier")
  decayRules         Json     @default("{}") @map("decay_rules")
  priority           Int      @default(100) @map("priority")
  isActive           Boolean  @default(false) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([code])
  @@index([isActive])
  @@map("economy_profiles")
}

model PromotionCampaignRecord {
  id               String   @id @default(uuid()) @map("campaign_id")
  campaignCode     String   @unique @map("campaign_code")
  title            String   @map("title")
  description      String   @map("description")
  discountPct      Float    @default(0.0) @map("discount_pct")
  yieldBoostMult   Decimal  @default(1.0) @db.Decimal(36, 18) @map("yield_boost_mult")
  startsAt         DateTime @map("starts_at")
  endsAt           DateTime @map("ends_at")
  status           String   @default("ACTIVE") @map("status")
  metadata         Json?    @default("{}") @map("metadata")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([campaignCode])
  @@index([status, startsAt, endsAt])
  @@map("promotion_campaigns")
}

model MaintenanceWindowRecord {
  id            String   @id @default(uuid()) @map("window_id")
  scope         String   @map("scope")
  targetId      String?  @map("target_id")
  mode          String   @default("NO_CLAIMS") @map("mode")
  customMessage String?  @map("custom_message")
  startsAt      DateTime @map("starts_at")
  endsAt        DateTime @map("ends_at")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([scope, targetId])
  @@index([isActive, startsAt, endsAt])
  @@map("maintenance_windows")
}

model PlatformOperationalConfig {
  id                        String   @id @default("AUTHORITATIVE_PLATFORM_CONFIG") @map("config_id")
  version                   Int      @default(1) @map("version")
  maintenanceMode           Boolean  @default(false) @map("maintenance_mode")
  readOnlyMode              Boolean  @default(false) @map("read_only_mode")
  disableRegistrations      Boolean  @default(false) @map("disable_registrations")
  disablePurchases          Boolean  @default(false) @map("disable_purchases")
  disableWithdrawals        Boolean  @default(false) @map("disable_withdrawals")
  disableClaims             Boolean  @default(false) @map("disable_claims")
  disableSettlements        Boolean  @default(false) @map("disable_settlements")
  disabledAssets            Json     @default("[]") @map("disabled_assets")
  disabledMachineCategories Json     @default("[]") @map("disabled_machine_categories")
  reason                    String   @default("INITIAL_BOOTSTRAP") @map("reason")
  updatedBy                 String   @default("SYSTEM") @map("updated_by")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@map("platform_operational_configs")
}

enum UsdtTxProcessingStatus {
  DETECTED
  CONFIRMING
  CONFIRMED
  MATCHED
  VERIFYING
  PENDING_ADMIN_APPROVAL
  SETTLED
  DUPLICATE
  UNDERPAYMENT
  OVERPAYMENT
  AMBIGUOUS_MATCH
  INVALID_TOKEN
  INVALID_NETWORK
  INVALID_RECIPIENT
  FAILED
  RECONCILIATION_REQUIRED
}

model UsdtConfig {
  id                    String    @id @default("default") @map("id")
  enabled               Boolean   @default(true) @map("enabled")
  network               String    @default("TRON") @map("network")
  tokenContract         String    @default("TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t") @map("token_contract")
  receivingAddress      String    @map("receiving_address")
  requiredConfirmations Int       @default(19) @map("required_confirmations")
  pollIntervalSeconds   Int       @default(10) @map("poll_interval_seconds")
  lastScannedBlock      BigInt    @default(0) @map("last_scanned_block")
  lastScanAt            DateTime? @map("last_scan_at")
  configuredByAdminId   String?   @map("configured_by_admin_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("usdt_configs")
}

model UsdtAddressHistory {
  id                  String    @id @default(uuid()) @map("id")
  address             String    @map("address")
  network             String    @map("network")
  tokenContract       String    @map("token_contract")
  configuredByAdminId String?   @map("configured_by_admin_id")
  activatedAt         DateTime  @default(now()) @map("activated_at")
  deactivatedAt       DateTime? @map("deactivated_at")
  reason              String?   @map("reason")

  @@index([address])
  @@index([network])
  @@map("usdt_address_histories")
}

model UsdtBlockchainTransaction {
  id                    String                 @id @default(uuid()) @map("id")
  transactionHash       String                 @map("transaction_hash")
  network               String                 @map("network")
  tokenContract         String                 @map("token_contract")
  blockNumber           BigInt                 @map("block_number")
  blockTimestamp        DateTime               @map("block_timestamp")
  senderAddress         String                 @map("sender_address")
  recipientAddress      String                 @map("recipient_address")
  rawTokenAmount        String                 @map("raw_token_amount")
  normalizedAmount      Decimal                @map("normalized_amount") @db.Decimal(36, 18)
  confirmations         Int                    @default(0) @map("confirmations")
  onChainStatus         String                 @default("SUCCESS") @map("on_chain_status")
  processingStatus      UsdtTxProcessingStatus @default(DETECTED) @map("processing_status")
  anomalyReason         String?                @map("anomaly_reason")
  firstObservedAt       DateTime               @default(now()) @map("first_observed_at")
  lastObservedAt        DateTime               @default(now()) @map("last_observed_at")
  finalizedAt           DateTime?              @map("finalized_at")
  settlementSessionId   String?                @map("settlement_session_id")
  orchestratorReference String?                @map("orchestrator_reference")
  metadata              Json                   @default("{}") @map("metadata")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  @@unique([network, tokenContract, transactionHash], name: "usdt_tx_unique")
  @@index([transactionHash])
  @@index([recipientAddress])
  @@index([senderAddress])
  @@index([processingStatus])
  @@index([settlementSessionId])
  @@map("usdt_blockchain_transactions")
}

