generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserState {
  NEW
  AUTHENTICATED
  ONBOARDING_STARTED
  EDUCATION_REQUIRED
  CONSENT_REQUIRED
  READY
  ONBOARDING_WELCOME
  ONBOARDING_EDUCATION
  EDUCATION_COMPLETE
  CONSENT_PENDING
  READY_FOR_PLATFORM
  ELIGIBLE_USER
  ACTIVE_USER
  DORMANT_USER
  ONBOARDING_STALLED
  CONSENT_EXPIRED
  FROZEN
  SUSPENDED_USER
  BANNED_USER
  DELETED_USER
}

enum EducationModuleId {
  welcome
  platform
  funds
  actions
  risks
  withdrawal
  myths
  quiz
  crypto_basics
}

enum EducationStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum ConsentType {
  risk_acknowledgement
  terms_of_service
  privacy_policy
  data_processing
  marketing_opt_in
  kyc_consent
  not_a_bank
  rewards_not_guaranteed
  may_lose_value
  withdrawal_terms
  restricted_jurisdiction
}

enum AuditEventType {
  USER_AUTHENTICATED
  USER_CREATED
  USER_UPDATED
  ONBOARDING_STARTED
  ONBOARDING_STEP_COMPLETED
  ONBOARDING_RESUMED
  ONBOARDING_STALLED
  ONBOARDING_COMPLETED
  EDUCATION_MODULE_STARTED
  EDUCATION_MODULE_COMPLETED
  EDUCATION_QUIZ_ANSWERED
  EDUCATION_QUIZ_COMPLETED
  EDUCATION_ALL_COMPLETED
  CONSENT_RECORDED
  CONSENT_ACCEPTED
  CONSENT_EXPIRED
  CONSENT_ALL_COMPLETED
  READINESS_SCORED
  USER_READY
  USER_NOT_READY
  USER_STATE_CHANGED
  ACCOUNT_FROZEN
  ACCOUNT_SUSPENDED
  ACCOUNT_BANNED
  ACCOUNT_DELETED
  ADMIN_ACTION
  SECURITY_EVENT
  FINANCIAL_ACCOUNT_CREATED
  LEDGER_ENTRY_CREATED
  TRANSACTION_CREATED
  TRANSACTION_COMPLETED
  TRANSACTION_FAILED
  BALANCE_UPDATED
}

enum FinancialAccountStatus {
  ACTIVE
  RESTRICTED
  SUSPENDED
  CLOSED
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
  SYSTEM
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum TransactionStatus {
  CREATED
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
}

enum TransactionType {
  INTERNAL_ADJUSTMENT
  SYSTEM_ALLOCATION
  REVERSAL
  WITHDRAWAL_RESERVE
  WITHDRAWAL_SETTLE
  WITHDRAWAL_REVERSAL
}

enum FinancialOperationType {
  INTERNAL_ADJUSTMENT
  SYSTEM_ALLOCATION
  REVERSAL
  WITHDRAWAL_RESERVE
  WITHDRAWAL_SETTLE
  WITHDRAWAL_REVERSAL
}

enum FinancialOperationStatus {
  REQUESTED
  VALIDATED
  AUTHORIZED
  EXECUTING
  POSTED
  COMPLETED
  FAILED_VALIDATION
  FAILED_RISK
  FAILED_EXECUTION
  FAILED_EXTERNAL_PROVIDER
  CANCELLED
}

enum IdempotencyStatus {
  STARTED
  COMPLETED
  FAILED
}

enum FinancialRuleType {
  USER_READY
  ACCOUNT_ACTIVE
  ASSET_ENABLED
  MIN_AMOUNT
  DAILY_LIMIT
}

enum DomainEventType {
  FINANCIAL_OPERATION_REQUESTED
  FINANCIAL_OPERATION_AUTHORIZED
  LEDGER_POSTING_STARTED
  LEDGER_POSTING_COMPLETED
  LEDGER_POSTING_FAILED
  BALANCE_CHANGED
}

enum ReconciliationRunStatus {
  CREATED
  RUNNING
  COMPLETED
  FAILED
}

enum OperatorStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum OperatorAvailability {
  ONLINE
  OFFLINE
  PAUSED
}

enum SettlementType {
  DEPOSIT
  PAYOUT
}

enum SettlementStatus {
  CREATED
  INITIALIZED
  OPERATOR_ASSIGNED
  MERCHANT_ASSIGNED
  WAITING_FOR_PAYMENT
  WAITING_PAYMENT
  VERIFYING
  APPROVED
  POSTED
  PAYMENT_RECEIVED
  USDT_SENT
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
  REJECTED
  DISPUTED
  RISK_FLAGGED
  RISK_HOLD
}

enum SettlementEventType {
  SettlementCreated
  SettlementInitialized
  SettlementPaymentDetected
  SettlementVerificationStarted
  OperatorAssigned
  MerchantAssigned
  OperatorAccepted
  PaymentReceived
  USDTSent
  SettlementApproved
  SettlementCompleted
  SettlementRejected
  SettlementExpired
  SettlementCancelled
  SettlementDisputed
  RiskFlagged
}

enum OperationsQueueStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum SettlementProviderId {
  INTERNAL_OPERATIONS
  MERCHANT_MOBILE_MONEY
  CRYPTOBOT
  PESAPAL
  USDT
}

enum SettlementProviderStatus {
  ENABLED
  DISABLED
}

enum SettlementProviderHealthStatus {
  HEALTHY
  DEGRADED
  DOWN
}

enum AssetLicenseStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  REVOKED
}

enum AssetLicenseType {
  PURCHASED
  PROMOTIONAL
  ADMIN_GRANTED
  LIFETIME
}

model User {
  telegramUserId   BigInt    @id @map("telegram_user_id")
  telegramUsername String?   @map("telegram_username")
  firstName        String    @map("first_name")
  lastName         String?   @map("last_name")
  photoUrl         String?   @map("photo_url")
  languageCode     String    @default("en") @map("language_code")
  state            UserState @default(NEW) @map("state")

  loginCount   Int       @default(0) @map("login_count")
  lastActiveAt DateTime? @map("last_active_at")
  lastLoginAt  DateTime? @map("last_login_at")
  lastActiveIp String?   @map("last_active_ip")

  educationScore     Int     @default(0) @map("education_score")
  readinessScore     Int     @default(0) @map("readiness_score")
  isReady            Boolean @default(false) @map("is_ready")
  qualifiedReferrals Int     @default(0) @map("qualified_referrals")
  payingReferrals    Int     @default(0) @map("paying_referrals")

  channelVerified   Boolean   @default(false) @map("channel_verified")
  channelVerifiedAt DateTime? @map("channel_verified_at")

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  anonymizedAt DateTime? @map("anonymized_at")

  onboardingProgress        OnboardingProgress?
  educationCompletions      EducationCompletion[]
  userConsents              UserConsent[]
  auditEvents               AuditEvent[]
  readinessScores           ReadinessScore[]
  readinessHistory          ReadinessHistory[]
  stateTransitions          UserStateTransition[]
  financialAccount          FinancialAccount?
  financialOperations       FinancialOperation[]
  settlementSessions        SettlementSession[]
  referralCode              ReferralCode?
  referralAsReferrer        ReferralRelationship[]         @relation("ReferrerRelation")
  referralAsReferee         ReferralRelationship?          @relation("RefereeRelation")
  rewards                   Reward[]
  trustProfile              UserTrustProfile?
  userLevel                 UserLevelRecord?
  userBenefits              UserBenefit[]
  notifications             NotificationRecord[]
  notificationPreference    NotificationPreference?
  growthEvents              GrowthEvent[]
  qualificationHistory      ReferralQualificationHistory[]
  paymentInvoices           PaymentInvoice[]
  channelVerificationEvents ChannelVerificationEvent[]
  miningState               UserMiningState?
  productSubscriptions      ProductSubscription[]
  identityId                String?                        @map("identity_id")
  identity                  UniversalIdentity?             @relation(fields: [identityId], references: [id], onDelete: SetNull)
  userPreferences           UserPreferences?
  userMachines              UserMachine[]
  achievements              Achievement[]
  crystalAccount            CrystalAccount?
  crystalTransactions       CrystalTransaction[]
  gameSessions              GameSession[]
  gameProfile               GameProfile?
  gamePlayerStats           GamePlayerStat[]
  gameRewardGrants          GameRewardGrant[]
  gameChallengeCompletions  GameChallengeCompletion[]
  adminNotes                AdminNote[]
  assetLicenses             UserAssetLicense[]
  userMachineFleet          UserMachineFleetItem[]

  @@index([state])
  @@index([createdAt])
  @@index([isReady])
  @@index([state, updatedAt])
  @@map("users")
}

model AdminNote {
  id             String   @id @default(uuid()) @map("note_id")
  telegramUserId BigInt   @map("telegram_user_id")
  adminId        String   @map("admin_id")
  adminEmail     String?  @map("admin_email")
  message        String   @map("message")
  visibility     String   @default("INTERNAL") @map("visibility")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [telegramUserId], references: [telegramUserId], onDelete: Restrict)

  @@index([telegramUserId, createdAt])
  @@map("admin_notes")
}

model UserAssetLicense {
  id                      String              @id @default(uuid()) @map("license_id")
  telegramUserId          BigInt              @map("telegram_user_id")
  asset                   String              @map("asset")
  status                  AssetLicenseStatus  @default(ACTIVE) @map("status")
  licenseType             AssetLicenseType    @default(PURCHASED) @map("license_type")
  activatedAt             DateTime            @default(now()) @map("activated_at")
  expiresAt               DateTime?           @map("expires_at")
  grantedBy               String?             @map("granted_by")
  purchaseTransactionId   String?             @map("purchase_transaction_id")
  metadata                Json?               @default("{}") @map("metadata")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  user User @relation(fields: [telegramUserId], references: [telegramUserId], onDelete: Restrict)

  @@unique([telegramUserId, asset])
  @@index([telegramUserId])
  @@index([asset])
  @@index([status])
  @@index([expiresAt])
  @@map("user_asset_licenses")
}

model Asset {
  assetCode String   @id @map("asset_code")
  name      String   @map("name")
  symbol    String   @map("symbol")
  decimals  Int      @map("decimals")
  enabled   Boolean  @default(true) @map("enabled")
  icon      String?  @map("icon")
  color     String?  @map("color")
  network   String?  @map("network")
  metadata  Json?    @default("{}") @map("metadata")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ledgerEntries LedgerEntry[]
  transactions  FinancialTransaction[]
  balances      AssetBalance[]

  @@index([enabled])
  @@map("assets")
}

model AssetBalance {
  id               String   @id @default(uuid()) @map("balance_id")
  telegramUserId   BigInt   @map("telegram_user_id")
  assetCode        String   @map("asset")
  availableBalance Decimal  @default(0) @map("available_balance") @db.Decimal(36, 18)
  lockedBalance    Decimal  @default(0) @map("locked_balance") @db.Decimal(36, 18)
  totalEarned      Decimal  @default(0) @map("total_earned") @db.Decimal(36, 18)
  lastClaimedAt    DateTime? @map("last_claimed_at")
  metadata         Json?    @default("{}") @map("metadata")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  asset Asset @relation(fields: [assetCode], references: [assetCode], onDelete: Restrict)

  @@unique([telegramUserId, assetCode])
  @@index([telegramUserId])
  @@index([assetCode])
  @@map("asset_balances")
}

model FinancialAccount {
  id             String                 @id @default(uuid()) @map("financial_account_id")
  telegramUserId BigInt                 @unique @map("telegram_user_id")
  status         FinancialAccountStatus @default(ACTIVE) @map("status")
  activatedAt    DateTime?              @map("activated_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  user          User                   @relation(fields: [telegramUserId], references: [telegramUserId], onDelete: Restrict)
  ledgerEntries LedgerEntry[]
  transactions  FinancialTransaction[]
  operations    FinancialOperation[]

  @@index([telegramUserId])
  @@index([status])
  @@map("financial_accounts")
}

model LedgerAccount {
  id          String            @id @default(uuid()) @map("ledger_account_id")
  code        String            @unique @map("code")
  name        String            @map("name")
  type        LedgerAccountType @map("type")
  description String?           @map("description")
  enabled     Boolean           @default(true) @map("enabled")
  metadata    Json?             @map("metadata")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  ledgerEntries LedgerEntry[]

  @@index([type])
  @@index([enabled])
  @@map("ledger_accounts")
}

model TransactionGroup {
  id          String    @id @default(uuid()) @map("transaction_group_id")
  reference   String    @unique @map("reference")
  description String?   @map("description")
  metadata    Json?     @map("metadata")
  finalizedAt DateTime? @map("finalized_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  transactions  FinancialTransaction[]
  ledgerEntries LedgerEntry[]

  @@index([createdAt])
  @@map("transaction_groups")
}

model FinancialTransaction {
  id                 String            @id @default(uuid()) @map("transaction_id")
  financialAccountId String            @map("financial_account_id")
  transactionGroupId String?           @map("transaction_group_id")
  transactionType    TransactionType   @map("transaction_type")
  status             TransactionStatus @default(CREATED) @map("status")
  assetCode          String            @map("asset_code")
  amount             Decimal           @db.Decimal(36, 18)
  reference          String            @unique @map("reference")
  metadata           Json?             @map("metadata")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  processingAt       DateTime?         @map("processing_at")
  completedAt        DateTime?         @map("completed_at")
  failedAt           DateTime?         @map("failed_at")
  reversedAt         DateTime?         @map("reversed_at")

  financialAccount FinancialAccount     @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  transactionGroup TransactionGroup?    @relation(fields: [transactionGroupId], references: [id], onDelete: Restrict)
  asset            Asset                @relation(fields: [assetCode], references: [assetCode], onDelete: Restrict)
  operations       FinancialOperation[]

  @@index([financialAccountId])
  @@index([transactionGroupId])
  @@index([status])
  @@index([assetCode])
  @@index([createdAt])
  @@map("transactions")
}

model FinancialOperation {
  id                 String                   @id @default(uuid()) @map("operation_id")
  telegramUserId     BigInt                   @map("telegram_user_id")
  financialAccountId String                   @map("financial_account_id")
  transactionId      String?                  @map("transaction_id")
  operationType      FinancialOperationType   @map("operation_type")
  status             FinancialOperationStatus @default(REQUESTED) @map("status")
  assetCode          String                   @map("asset_code")
  amount             Decimal                  @db.Decimal(36, 18)
  idempotencyKey     String                   @map("idempotency_key")
  reference          String                   @unique @map("reference")
  requestPayload     Json                     @map("request_payload")
  failureCode        String?                  @map("failure_code")
  failureReason      String?                  @map("failure_reason")
  metadata           Json?                    @map("metadata")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")
  completedAt        DateTime?                @map("completed_at")

  user             User                    @relation(fields: [telegramUserId], references: [telegramUserId], onDelete: Restrict)
  financialAccount FinancialAccount        @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  transaction      FinancialTransaction?   @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  workflowSteps    FinancialWorkflowStep[]
  domainEvents     FinancialDomainEvent[]

  @@unique([telegramUserId, idempotencyKey])
  @@index([telegramUserId])
  @@index([financialAccountId])
  @@index([transactionId])
  @@index([status])
  @@index([assetCode])
  @@index([createdAt])
  @@map("financial_operations")
}

model FinancialRule {
  id            String                  @id @default(uuid()) @map("financial_rule_id")
  code          String                  @unique @map("code")
  ruleType      FinancialRuleType       @map("rule_type")
  enabled       Boolean                 @default(true) @map("enabled")
  assetCode     String?                 @map("asset_code")
  operationType FinancialOperationType? @map("operation_type")
  parameters    Json                    @default("{}") @map("parameters")
  description   String?                 @map("description")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  @@index([enabled])
  @@index([ruleType])
  @@index([assetCode])
  @@map("financial_rules")
}

model FinancialIdempotencyRecord {
  id              String            @id @default(uuid()) @map("idempotency_record_id")
  telegramUserId  BigInt            @map("telegram_user_id")
  idempotencyKey  String            @map("idempotency_key")
  requestHash     String            @map("request_hash")
  status          IdempotencyStatus @default(STARTED) @map("status")
  operationId     String?           @map("operation_id")
  responsePayload Json?             @map("response_payload")
  lockedUntil     DateTime?         @map("locked_until")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@unique([telegramUserId, idempotencyKey])
  @@index([operationId])
  @@index([status])
  @@map("financial_idempotency_records")
}

model FinancialWorkflowStep {
  id             String                    @id @default(uuid()) @map("workflow_step_id")
  operationId    String                    @map("operation_id")
  previousStatus FinancialOperationStatus? @map("previous_status")
  newStatus      FinancialOperationStatus  @map("new_status")
  trigger        String                    @map("trigger")
  metadata       Json?                     @map("metadata")
  createdAt      DateTime                  @default(now()) @map("created_at")

  operation FinancialOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)

  @@index([operationId])
  @@index([newStatus])
  @@index([createdAt])
  @@map("financial_workflow_steps")
}

model FinancialDomainEvent {
  id                 String          @id @default(uuid()) @map("domain_event_id")
  operationId        String?         @map("operation_id")
  telegramUserId     BigInt?         @map("telegram_user_id")
  financialAccountId String?         @map("financial_account_id")
  transactionId      String?         @map("transaction_id")
  eventType          DomainEventType @map("event_type")
  payload            Json            @default("{}") @map("payload")
  publishedAt        DateTime?       @map("published_at")
  createdAt          DateTime        @default(now()) @map("created_at")

  operation FinancialOperation? @relation(fields: [operationId], references: [id], onDelete: Restrict)

  @@index([operationId])
  @@index([telegramUserId])
  @@index([financialAccountId])
  @@index([transactionId])
  @@index([eventType])
  @@index([createdAt])
  @@map("financial_domain_events")
}

model ReconciliationRun {
  id            String                  @id @default(uuid()) @map("reconciliation_run_id")
  source        String                  @map("source")
  status        ReconciliationRunStatus @default(CREATED) @map("status")
  startedAt     DateTime?               @map("started_at")
  completedAt   DateTime?               @map("completed_at")
  summary       Json?                   @map("summary")
  failureReason String?                 @map("failure_reason")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  checkpoints ReconciliationCheckpoint[]

  @@index([source])
  @@index([status])
  @@index([createdAt])
  @@map("reconciliation_runs")
}

model ReconciliationCheckpoint {
  id          String   @id @default(uuid()) @map("reconciliation_checkpoint_id")
  runId       String   @map("reconciliation_run_id")
  subject     String   @map("subject")
  externalRef String?  @map("external_ref")
  ledgerRef   String?  @map("ledger_ref")
  status      String   @map("status")
  details     Json?    @map("details")
  createdAt   DateTime @default(now()) @map("created_at")

  run ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@index([runId])
  @@index([subject])
  @@index([status])
  @@map("reconciliation_checkpoints")
}

model Operator {
  id                           String               @id @default(uuid()) @map("operator_id")
  displayName                  String               @map("display_name")
  whatsappNumber               String               @map("whatsapp_number")
  telegramUsername             String?              @map("telegram_username")
  country                      String               @map("country")
  supportedCurrencies          Json                 @default("[]") @map("supported_currencies")
  supportedMobileMoneyNetworks Json                 @default("[]") @map("supported_mobile_money_networks")
  mobileMoneyNumber            String               @map("mobile_money_number")
  status                       OperatorStatus       @default(ACTIVE) @map("status")
  availability                 OperatorAvailability @default(OFFLINE) @map("availability")
  capacity                     Int                  @default(5) @map("capacity")
  currentLoad                  Int                  @default(0) @map("current_load")
  trustScore                   Int                  @default(50) @map("trust_score")
  averageCompletionTimeSeconds Int                  @default(900) @map("average_completion_time_seconds")
  dailyLimit                   Decimal              @map("daily_limit") @db.Decimal(36, 18)
  authTokenHash                String?              @map("auth_token_hash")
  createdAt                    DateTime             @default(now()) @map("created_at")
  updatedAt                    DateTime             @updatedAt @map("updated_at")

  sessions          SettlementSession[]
  operatorSessions  OperatorSession[]
  capacitySnapshots OperatorCapacity[]
  metrics           OperatorMetric[]
  notes             SettlementNote[]

  @@index([status, availability])
  @@index([country])
  @@map("operators")
}

model OperatorSession {
  id         String    @id @default(uuid()) @map("operator_session_id")
  operatorId String    @map("operator_id")
  tokenHash  String    @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId])
  @@index([tokenHash])
  @@map("operator_sessions")
}

model OperatorCapacity {
  id             String   @id @default(uuid()) @map("operator_capacity_id")
  operatorId     String   @map("operator_id")
  businessDate   DateTime @map("business_date")
  acceptedCount  Int      @default(0) @map("accepted_count")
  completedCount Int      @default(0) @map("completed_count")
  rejectedCount  Int      @default(0) @map("rejected_count")
  settledAmount  Decimal  @default(0) @map("settled_amount") @db.Decimal(36, 18)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@unique([operatorId, businessDate])
  @@index([businessDate])
  @@map("operator_capacity")
}

model SettlementSession {
  id                    String               @id @default(uuid()) @map("settlement_id")
  telegramUserId        BigInt               @map("telegram_user_id")
  operatorId            String?              @map("operator_id")
  provider              SettlementProviderId @default(INTERNAL_OPERATIONS) @map("provider")
  sessionType           SettlementType       @default(DEPOSIT) @map("session_type")
  asset                 String               @map("asset")
  requestedAmount       Decimal              @map("requested_amount") @db.Decimal(36, 18)
  expectedCryptoAmount  Decimal              @map("expected_crypto_amount") @db.Decimal(36, 18)
  exchangeRate          Decimal              @map("exchange_rate") @db.Decimal(36, 18)
  country               String               @map("country")
  mobileMoneyNetwork    String               @map("mobile_money_network")
  referenceCode         String               @unique @map("reference_code")
  status                SettlementStatus     @default(CREATED) @map("status")
  expiresAt             DateTime             @map("expires_at")
  merchantAssignedAt    DateTime?            @map("merchant_assigned_at")
  paymentReceivedAt     DateTime?            @map("payment_received_at")
  usdtSentAt            DateTime?            @map("usdt_sent_at")
  completedAt           DateTime?            @map("completed_at")
  orchestratorReference String?              @map("orchestrator_reference")
  providerMetadata      Json                 @default("{}") @map("provider_metadata")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  user     User              @relation(fields: [telegramUserId], references: [telegramUserId], onDelete: Restrict)
  operator Operator?         @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  events   SettlementEvent[]
  notes    SettlementNote[]

  @@index([telegramUserId])
  @@index([operatorId])
  @@index([provider])
  @@index([status])
  @@index([expiresAt])
  @@map("settlement_sessions")
}

model SettlementEvent {
