  level       UserLevelTier @map("level")
  benefitType BenefitType   @map("benefit_type")
  parameters  Json          @default("{}") @map("parameters")
  enabled     Boolean       @default(true) @map("enabled")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  userBenefits UserBenefit[]

  @@index([level])
  @@index([enabled])
  @@map("benefit_rules")
}

model UserBenefit {
  id             String   @id @default(uuid()) @map("id")
  telegramUserId BigInt   @map("telegram_user_id")
  benefitRuleId  String   @map("benefit_rule_id")
  status         String   @default("ACTIVE") @map("status")
  grantedAt      DateTime @default(now()) @map("granted_at")
  expiresAt      DateTime? @map("expires_at")

  user User        @relation(fields: [telegramUserId], references: [telegramUserId], onDelete: Cascade)
  rule BenefitRule @relation(fields: [benefitRuleId], references: [id], onDelete: Cascade)

  @@index([telegramUserId])
  @@index([status])
  @@map("user_benefits")
}

model BenefitHistory {
  id             String   @id @default(uuid()) @map("id")
  telegramUserId BigInt   @map("telegram_user_id")
  benefitCode    String   @map("benefit_code")
  action         String   @map("action")
  metadata       Json?    @map("metadata")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([telegramUserId])
  @@map("benefit_history")
}

model NotificationTemplate {
  id            String              @id @default(uuid()) @map("id")
  code          String              @unique @map("code")
  name          String              @map("name")
  titleTemplate String              @map("title_template")
  bodyTemplate  String              @map("body_template")
  channel       NotificationChannel @default(TELEGRAM) @map("channel")
  enabled       Boolean             @default(true) @map("enabled")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@index([code])
  @@map("notification_templates")
}

model NotificationRecord {
  id             String              @id @default(uuid()) @map("id")
  telegramUserId BigInt              @map("telegram_user_id")
  templateCode   String              @map("template_code")
  message        String              @map("message")
  channel        NotificationChannel @default(TELEGRAM) @map("channel")
  status         String              @default("SENT") @map("status")
  metadata       Json?               @map("metadata")
  createdAt      DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [telegramUserId], references: [telegramUserId], onDelete: Cascade)

  @@index([telegramUserId])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id               String   @id @default(uuid()) @map("id")
  telegramUserId   BigInt   @unique @map("telegram_user_id")
  telegramEnabled Boolean  @default(true) @map("telegram_enabled")
  inAppEnabled     Boolean  @default(true) @map("in_app_enabled")
  marketingEnabled Boolean  @default(false) @map("marketing_enabled")
  eventPreferences Json     @default("{}") @map("event_preferences")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [telegramUserId], references: [telegramUserId], onDelete: Cascade)

  @@map("notification_preferences")
}

model BotBroadcast {
  id           String    @id @default(uuid()) @map("id")
  title        String    @map("title")
  message      String    @map("message")
  target       String    @default("ALL") @map("target")
  sentCount    Int       @default(0) @map("sent_count")
  failedCount  Int       @default(0) @map("failed_count")
  status       String    @default("PENDING") @map("status")
  createdById  String?   @map("created_by_id")
  metadata     Json?     @map("metadata")
  createdAt    DateTime  @default(now()) @map("created_at")
  completedAt  DateTime? @map("completed_at")

  @@index([status])
  @@index([createdAt])
  @@map("bot_broadcasts")
}

enum PaymentInvoiceStatus {
  CREATED
  WAITING_FOR_PAYMENT
  PAID
  EXPIRED
  FAILED
  REFUNDED
}

model PaymentInvoice {
  id                String               @id @default(uuid()) @map("invoice_id")
  telegramUserId    BigInt               @map("telegram_user_id")
  provider          SettlementProviderId @default(CRYPTOBOT) @map("provider")
  externalInvoiceId String               @unique @map("external_invoice_id")
  asset             String               @map("asset")
  amount            Decimal              @db.Decimal(36, 18) @map("amount")
  currency          String               @map("currency")
  payUrl            String               @map("pay_url")
  status            PaymentInvoiceStatus @default(CREATED) @map("status")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  paidAt            DateTime?            @map("paid_at")
  metadata          Json?                @map("metadata")

  user User @relation(fields: [telegramUserId], references: [telegramUserId], onDelete: Restrict)

  @@index([telegramUserId])
  @@index([externalInvoiceId])
  @@index([status])
  @@index([createdAt])
  @@map("payment_invoices")
}

model ChannelVerificationEvent {
  id             String   @id @default(uuid()) @map("id")
  telegramUserId BigInt   @map("telegram_user_id")
  channelId      String   @map("channel_id")
  status         String   @map("status")
  verifiedAt     DateTime @default(now()) @map("verified_at")
  metadata       Json?    @map("metadata")

  user User @relation(fields: [telegramUserId], references: [telegramUserId], onDelete: Cascade)

  @@index([telegramUserId])
  @@index([channelId])
  @@index([verifiedAt])
  @@map("channel_verification_events")
}

model EmergencyControlState {
  id                String   @id @default("SYSTEM_EMERGENCY_STATE") @map("id")
  depositsPaused    Boolean  @default(false) @map("deposits_paused")
  withdrawalsPaused Boolean  @default(false) @map("withdrawals_paused")
  rewardsPaused     Boolean  @default(false) @map("rewards_paused")
  updatedBy         String?  @map("updated_by")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("emergency_control_states")
}

model ProductSubscription {
  id             String    @id @default(uuid()) @map("id")
  telegramUserId BigInt    @map("telegram_user_id")
  productCode    String    @map("product_code")
  status         String    @default("ACTIVE") @map("status")
  expiresAt      DateTime? @map("expires_at")
