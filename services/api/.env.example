# Required production configuration. Set real values in the deployment secret
# store; never commit them.
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
ADMIN_SESSION_PEPPER=replace-with-a-different-long-random-admin-pepper
TELEGRAM_BOT_TOKEN=replace-with-the-production-bot-token
TELEGRAM_BOT_USERNAME=titanstream_bot
TELEGRAM_WEBAPP_URL=https://your-production-web-origin.example
SUPER_ADMIN_TELEGRAM_IDS=123456789
USDT_RECEIVING_ADDRESS=your-validated-trc20-treasury-address
TRONGRID_API_KEY=required-for-reliable-production-chain-monitoring

# Local mobile-money rail (East Africa only). Card payments remain disabled.
PESAPAL_ENVIRONMENT=production
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_BASE_URL=https://pay.pesapal.com/v3
PESAPAL_IPN_ID=
PESAPAL_CALLBACK_URL=https://your-api-origin.example/api/v1/settlement/pesapal/ipn
